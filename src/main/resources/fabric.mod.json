{
	"schemaVersion": 1,
	"id": "easy-auto-fishing",
	"version": "${version}",
	"name": "Easy Auto Fishing",
	"description": "Client-side auto fishing. Press K to toggle: casts automatically, reels in when your bobber splashes, and stops before your rod breaks.",
	"authors": [
		"Shinichicken"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/easy-auto-fishing/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.shinichicken.easyautofishing.client.EasyAutoFishingClient"
		]
	},
	"mixins": [
		"easy-auto-fishing.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
